{
  "name": "voyage",
  "private": true,
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --cwd apps/web build && bun run --cwd apps/mcp build",
    "check": "bun run format:check && bun run typecheck && bun run test && bun run build",
    "check:all": "bun run check && bun run check:ios",
    "check:ios": "bash scripts/check-ios.sh",
    "configure:ios": "bash scripts/configure-ios.sh",
    "db:migrate:production": "bun run --cwd apps/web db:migrate:production",
    "db:migrate:staging": "bun run --cwd apps/web db:migrate:staging",
    "deploy": "bun run --cwd apps/web deploy",
    "deploy:production": "bun run --cwd apps/web deploy:production",
    "deploy:staging": "bun run --cwd apps/web deploy:staging",
    "deploy:mcp:production": "bun run --cwd apps/mcp deploy:production",
    "deploy:mcp:staging": "bun run --cwd apps/mcp deploy:staging",
    "dev": "bun run --cwd apps/web dev",
    "dev:mcp": "bun run --cwd apps/mcp dev",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "preview": "bun run --cwd apps/web preview",
    "setup:worktree": "bash scripts/setup-worktree.sh",
    "test": "bun run --cwd apps/web test && bun run --cwd apps/mcp test",
    "typecheck": "bun run --cwd apps/web typecheck && bun run --cwd apps/mcp typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4"
  }
}
