{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "voyage-mcp-staging",
  "main": "./src/index.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "mcp-staging.voyageplan.app",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voyage-production",
      "database_id": "d6747c04-a897-4d16-afc4-eff3d29acd6a",
      "migrations_dir": "../web/migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "staging",
    "APP_URL": "https://voyageplan.app",
    "MCP_RESOURCE_URL": "https://mcp-staging.voyageplan.app",
    "CLERK_AUTHORIZATION_SERVER": "https://clerk.voyageplan.app"
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
