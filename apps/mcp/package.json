{
  "name": "@voyage/mcp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --env=\"\" --outdir dist",
    "cf-typegen": "wrangler types",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env=\"\"",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "deploy:production": "wrangler deploy --env=\"\"",
    "deploy:staging": "wrangler deploy --env staging",
    "dev": "wrangler dev --env staging",
    "test": "vitest run && bun scripts/verify-evals.mjs && bun scripts/verify-plugin.mjs",
    "typecheck": "tsc --noEmit",
    "verify:oauth": "bun scripts/verify-oauth.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.11.7",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@voyage/contracts": "workspace:*",
    "agents": "^0.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@cloudflare/workers-types": "^5.20260718.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  }
}
